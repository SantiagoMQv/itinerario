  "components": [
    {
      "name": "Pestañas de día",
      "kind": "nav",
      "refersTo": "pestana-dia",
      "description": "Separadores de cartón sobre la tapa kraft; la activa sube en su color.",
      "html": "<nav class=\"ds-barra\"><button class=\"ds-pestana ds-todo\"><b>Todo</b></button><button class=\"ds-pestana ds-activa\" style=\"--color:#2453d1\"><b>Día 1</b><small>mié 21</small></button><button class=\"ds-pestana\" style=\"--color:#1e7f3e\"><b>Día 2</b><small>jue 22</small></button><button class=\"ds-pestana\" style=\"--color:#c8327e\"><b>Día 3</b><small>vie 23 · Nankín</small></button></nav>",
      "css": ".ds-barra{display:flex;align-items:flex-end;gap:4px;height:54px;padding:0 8px;background:#a8804f;box-shadow:0 1px 0 rgba(20,33,61,.25);font-family:var(--fuente, 'Archivo Variable', 'Archivo', system-ui, sans-serif);font-variant-numeric:tabular-nums}.ds-pestana{display:flex;flex-direction:column;justify-content:center;min-width:78px;height:50px;padding:0 12px 6px;border:none;border-radius:9px 9px 0 0;background:var(--color,#efe3d2);color:#fff;line-height:1.12;white-space:nowrap;box-shadow:inset 0 -1px 0 rgba(0,0,0,.18);transform:translateY(6px);transition:transform .25s cubic-bezier(.16,1,.3,1);cursor:pointer;font-family:inherit}.ds-pestana b{font-size:15px;font-weight:700}.ds-pestana small{font-size:12.5px;font-weight:500;font-stretch:92%}.ds-todo{min-width:70px;color:#14213d}.ds-pestana:hover{transform:translateY(3px)}.ds-activa,.ds-activa:hover{padding-bottom:0;transform:none;box-shadow:0 -2px 6px rgba(20,16,10,.28)}.ds-pestana:focus-visible{outline:2.5px solid #2453d1;outline-offset:2px}"
    },
    {
