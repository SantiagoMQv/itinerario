{
  "name": "itinerario",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.pruebas.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "maplibre-gl": "^6.11.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
