{
  "name": "itinerario",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:privado": "tsc --noEmit && tsc --noEmit -p tsconfig.pruebas.json && node scripts/build-privado.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.pruebas.json && npm run check:servidor",
    "check:servidor": "tsc --noEmit -p tsconfig.servidor.json && tsc --noEmit -p tsconfig.pruebas-servidor.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "maplibre-gl": "^6.11.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "4.151.0"
  }
}
